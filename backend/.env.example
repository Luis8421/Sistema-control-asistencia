# Copia este archivo como .env dentro de backend para desarrollo local.
# Deja DATABASE_URL vacia para usar SQLite local.
DATABASE_PATH="./dev.db"
DATABASE_URL=

# En produccion configura DATABASE_URL en el panel del host del backend.
# La URL se obtiene en Supabase > Project Settings > Database > Connection string.
# Nunca la pongas en archivos del frontend ni la compartas por chat.

# Supabase URL/anon key no se usan en el backend con la arquitectura Express + pg.
# Si otro cliente las necesita, usa solo variables publicas y nunca service_role.
SUPABASE_URL=TU_SUPABASE_URL
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# Genera un valor aleatorio de al menos 32 caracteres para cada entorno.
JWT_SECRET=TU_JWT_SECRET
PORT=4000
DATABASE_POOL_MAX=10

# Duracion de la sesion (JWT) del panel de administracion (supervisor/admin).
# Formato aceptado por la libreria jsonwebtoken: "12h", "30m", "7d", etc.
JWT_EXPIRES_IN=12h

# Duracion de la sesion (JWT) de empleados normales (Portal de Marcaje, app
# movil) — deliberadamente larga: inician sesion una vez en su celular y
# no se les vuelve a pedir codigo/PIN.
JWT_EXPIRES_IN_EMPLEADO=180d

# Origenes permitidos para CORS (separados por coma), ej:
# CORS_ORIGIN=https://mipanel.com,http://localhost
CORS_ORIGIN=http://localhost

# Precision maxima de GPS aceptada, en metros. Si el dispositivo reporta
# una precision peor que esta, el marcaje se invalida y se pide reintentar.
MAX_GPS_PRECISION_M=50
