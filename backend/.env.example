# Copia este archivo como .env antes de correr el proyecto

# Ruta del archivo de base de datos SQLite (se crea automaticamente)
DATABASE_PATH="./dev.db"

JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
PORT=4000

# API key fija para el panel web de administracion (empleados, geocercas,
# marcaciones). El panel la envia en el header X-API-Key. Genera un valor
# aleatorio propio (no uses este placeholder) y ponlo tambien en
# web/js/api.js.
ADMIN_API_KEY=miclave123

# Origenes permitidos para CORS (separados por coma), ej:
# CORS_ORIGIN=https://mipanel.com,http://localhost
CORS_ORIGIN=http://localhost

# Precision maxima de GPS aceptada, en metros. Si el dispositivo reporta
# una precision peor que esta, el marcaje se invalida y se pide reintentar.
MAX_GPS_PRECISION_M=50
