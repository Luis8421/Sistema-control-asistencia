# Plantilla de .env para el VPS de PRODUCCION. Copiar como .env en el VPS
# y completar los valores marcados con <...>. NO reutilizar ningun valor
# del .env de desarrollo de esta PC (192.168.231.11) — en particular el
# JWT_SECRET debe ser nuevo y exclusivo de produccion.

DATABASE_PATH="./dev.db"

# Generar uno nuevo en el VPS con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<generar-uno-nuevo-en-el-vps-nunca-reusar-el-de-desarrollo>"

PORT=4000
NODE_ENV=production

JWT_EXPIRES_IN=12h

# Unicamente el dominio publico real. Sin *, sin localhost, sin 127.0.0.1,
# sin 192.168.231.11, sin asistencia.local — esos son solo de desarrollo.
CORS_ORIGIN=https://marcaciones.telconet.ec

# Se mantiene igual que en desarrollo (10 m) hasta autorizacion explicita
# de cambiar a 50 m — ese cambio es de DATOS (tabla bodegas), no de esta
# variable, que solo controla la precision maxima de GPS aceptada.
MAX_GPS_PRECISION_M=50
