{
  "name": "asistencia-backend",
  "version": "1.0.0",
  "description": "Backend - Sistema de Control de Asistencia con Geolocalizacion (Fase 1 MVP)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:postgres": "node src/db/migratePostgres.js",
    "migrate:data": "node src/db/migrateData.js",
    "sqlite:copy": "node src/db/copySqlite.js",
    "seed": "node src/seed.js",
    "backup": "node src/backup.js",
    "import-empleados": "node src/importEmpleados.js",
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=text-summary node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.1.4"
  }
}
