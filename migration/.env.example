# Set these variables in a private shell or secret manager. Never commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=control_asistencia
MYSQL_USER=TU_MYSQL_READONLY_USER
MYSQL_PASSWORD=TU_MYSQL_READONLY_PASSWORD

# MySQL TIMESTAMP values are read with this session timezone. The source
# export uses UTC; DATETIME values are preserved as timezone-free wall time.
MYSQL_TIME_ZONE=+00:00

# PostgreSQL connection URI from Supabase. Keep it secret and server-side.
DATABASE_URL="TU_DATABASE_URL"
PG_SCHEMA=public
